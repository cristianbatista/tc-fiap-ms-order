# Application
APP_NAME=MS-Order
APP_VERSION=1.0.0
APP_DESCRIPTION=Microsserviço para gerenciamento de pedidos e catálogo

# Service
SERVICE_NAME=ms-order
SERVICE_PORT=8001
SERVICE_HOST=0.0.0.0

# Database
DATABASE_URL=postgresql://order_user:order_pass@db-order:5432/order_db
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# API
API_V1_PREFIX=/api/v1
DOCS_URL=/api/docs
REDOC_URL=/api/redoc
OPENAPI_URL=/api/openapi.json

# Environment
ENVIRONMENT=development
DEBUG=true

# CORS (comma-separated for multiple origins)
CORS_ORIGINS=*
CORS_METHODS=*
CORS_HEADERS=*

# Features
INIT_CATALOG=true

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Security (for future use)
SECRET_KEY=your-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30

# Health check
HEALTH_CHECK_INTERVAL=30
